<view class="container">
  <view class="title">绑定站点账号</view>
  <view class="desc">使用学号 + 密码完成绑定并登录</view>
  <view class="form">
    <input placeholder="学号（12位数字）" type="number" maxlength="12" bindinput="onStudentId" value="{{studentId}}"/>
    <input placeholder="密码（6-12位字母或数字）" password="true" maxlength="12" bindinput="onPassword" value="{{password}}"/>
    <button class="btn" type="primary" loading="{{loading}}" bindtap="onBind">绑定并登录</button>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
  <view class="tips">绑定成功后，下次可直接在小程序内自动登录。</view>
</view>